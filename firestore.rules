rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidAffiliateApplication(data) {
      return data.keys().hasAll(['name', 'email', 'profession', 'linkSource', 'status', 'createdAt'])
        && data.keys().size() == 6
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.profession is string && data.profession.size() > 0 && data.profession.size() <= 200
        && data.linkSource is string && data.linkSource.size() > 0 && data.linkSource.size() <= 500
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt == request.time;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['type', 'fullName', 'email', 'createdAt'])
        && data.type in ['DEMO', 'FREE_TRIAL', 'CONTACT']
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.createdAt == request.time
        // Optional referral code
        && (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 50))
        // Optional metadata
        && (!('metadata' in data) || data.metadata is map);
    }

    // --- Collection Rules ---

    // Affiliate Applications
    match /affiliateApplications/{applicationId} {
      allow create: if isValidId(applicationId) 
        && isValidAffiliateApplication(incoming())
        && incoming().status == 'pending';
      
      allow get, list, update, delete: if isAdmin();
    }

    // Leads
    match /leads/{leadId} {
      allow create: if isValidId(leadId) 
        && isValidLead(incoming());
      
      allow get, list, update, delete: if isAdmin();
    }

    // Admins (Self-management or Admin-invite only)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via Cloud Console or backend for now
    }
  }
}
