
{
  "entities": {
    "AffiliateApplication": {
      "title": "Affiliate Application",
      "description": "Clinical advocate application for the partnership program",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Candidate full name" },
        "email": { "type": "string", "format": "email", "description": "Professional email" },
        "profession": { "type": "string", "description": "Clinical specialty" },
        "linkSource": { "type": "string", "description": "Where they plan to share their link" },
        "message": { "type": "string", "description": "Partnership vision" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Application status" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "profession", "linkSource", "status", "createdAt"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Form submission from a potential clinician client",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["DEMO", "FREE_TRIAL", "CONTACT"] },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "referralCode": { "type": "string", "description": "The tracking code captured from URL" },
        "metadata": { "type": "object", "description": "Form specific fields" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "fullName", "email", "createdAt"]
    }
  },
  "firestore": {
    "/affiliateApplications/{applicationId}": {
      "schema": "AffiliateApplication",
      "description": "Public submissions for partnership"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Referred or direct leads captured across the site"
    }
  }
}
